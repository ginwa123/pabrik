#!/usr/bin/env sh
# Pre-commit hook — mirror CI's `lint (oxlint + eslint)` job exactly so
# commits can't slip past locally with lint errors that CI would catch.
#
# Mirrors the two lint steps in the `lint` job of
# `.github/workflows/ci.yml`:
#   working-directory: src/apps/desktop
#   run: pnpm run lint:check
# and
#   run: bash scripts/lint-no-catch-unreachable.sh --selftest
#        bash scripts/lint-no-catch-unreachable.sh
#
# That first step used to live at ci.yml lines 1485-1491 and the CI job
# was deleted in PR #398 ("drop frontend job"), which left this hook
# mirroring nothing. It is back as a gate as of the pipeline
# restructure, so the mirror is real again.
#
# The frontend lint runs in a SUBSHELL, not a bare `cd`. Husky runs this
# script from the worktree root (per core.hooksPath), and the Zig half
# below invokes `scripts/lint-no-catch-unreachable.sh` by a path that is
# relative to that root — so the CWD must still be the root when it runs.
# A bare `cd src/apps/desktop` followed by `cd ../..` does NOT get back
# there: it lands in `src/`, and the Zig step then dies with
# `bash: scripts/lint-no-catch-unreachable.sh: No such file or directory`
# (exit 127) — which is exactly the failure that shipped this hook broken
# in #926. `.husky/pre-push` already uses the subshell form for the same
# reason.
#
# Bypass for emergencies: `git commit --no-verify`.

set -e

echo "→ pnpm run lint:check (src/apps/desktop)"
(cd src/apps/desktop && pnpm run lint:check)

echo "→ zig coding standards (no catch unreachable)"
bash scripts/lint-no-catch-unreachable.sh --selftest
bash scripts/lint-no-catch-unreachable.sh
